{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "zoe-star.de" }],
      "destination": "https://www.zoe-star.de/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/send-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/analyse-worker",
      "schedule": "15 9 * * *"
    },
    {
      "path": "/api/cron/content-cleanup",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/birthday-reminders",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/notify-ranking",
      "schedule": "5 12 * * *"
    },
    {
      "path": "/api/cron/analyse-watchdog",
      "schedule": "*/5 * * * *"
    }
  ]
}
