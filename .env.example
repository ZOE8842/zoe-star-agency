# ZOE Star Agency Webapp · ENV TEMPLATE
# Kopiere zu .env.local und fülle Werte ein.

# Supabase (public/anon — Client-safe)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxx

# Supabase Service-Role (Server-Only · niemals im Client)
SUPABASE_SERVICE_ROLE_KEY=eyJxxxx

# Resend (Server-Only · für Mailversand)
RESEND_API_KEY=re_xxxx
RESEND_FROM_EMAIL=noreply@zoe-star.de

# Site Config
NEXT_PUBLIC_SITE_URL=https://zoe-star.de
NEXT_PUBLIC_SITE_NAME=ZOE Star Agency

# Telegram (Phase 2 optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Cron-Auth (Pflicht · fail-closed wenn unset)
# Wert: langer zufaelliger String (>=32 chars). Vercel-Cron sendet ihn als
# Authorization: Bearer <CRON_SECRET>. Ohne diese Var antworten alle
# /api/cron/*-Endpoints mit 503.
CRON_SECRET=

# Anthropic / Claude (Server-Only · Analyse-Worker + Content-Helper)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_TIMEOUT_MS=50000

# Apify (Server-Only · TikTok-Profile-Scraping fuer Account-Analyse)
APIFY_TOKEN=

# Sentry (optional · Error-Tracking)
# Wenn gesetzt, werden Client- + Server-Errors gesendet.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Debug-Instrumentation (optional · env-gated tracing)
# Wenn "true": DEBUG-Balken + Client-Console-Logs + Server-Action-Logs aktiv.
NEXT_PUBLIC_DEBUG_EVENT_FORM=

# Vercel · automatisch von Vercel gesetzt (kein manueller Eintrag noetig)
# Wird im Admin-Build-Footer angezeigt zum Deploy-Verify.
# VERCEL_GIT_COMMIT_SHA=
