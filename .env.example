# ZOE Star Agency Webapp · Phase 1 · ENV TEMPLATE
# Kopiere zu .env.local und fülle Werte ein.

# Supabase (public/anon — Client-safe)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxx

# Supabase Service-Role (Server-Only · niemals im Client)
SUPABASE_SERVICE_ROLE_KEY=eyJxxxx

# Resend (Server-Only · für Mailversand)
RESEND_API_KEY=re_xxxx
RESEND_FROM_EMAIL=noreply@zoe-star.de

# Site Config
NEXT_PUBLIC_SITE_URL=https://zoe-star.de
NEXT_PUBLIC_SITE_NAME=ZOE Star Agency

# Telegram (Phase 2 optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
